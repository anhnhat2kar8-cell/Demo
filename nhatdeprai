local function KhoiTaoHack()
    print("===========================================")
    print("[KHOI TAO] Dang tim Hắc Long Katana...")

    hackTool = TimHacLongKatana()

    if hackTool then
        print("[OK] Da tim thay Hắc Long Katana!")

        -- Phân tích Tool để tìm Remote
        remoteCuaTool = PhanTichTool(hackTool)

        -- Tự động cầm Tool
        if AUTO_EQUIP then
            AutoEquipTool()
        end

        print("[SAN SANG] Hack da kich hoat!")
        print("[TOOL]", hackTool:GetFullName())
        print("[DAMAGE] x", DAMAGE_MULTIPLIER)
    else
        warn("[CHUA TIM THAY] Hắc Long Katana khong co trong game.")
        warn("[GOI Y] Hay dam bao Tool co ten CHINH XAC: 'Hắc Long Katana'")
        warn("[GOI Y] Script se tu dong tim lai moi 3 giay...")
    end

    print("===========================================")
end

