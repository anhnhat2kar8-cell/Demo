local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ============================
-- PHẦN 2: TÌM PART GỐC "DinhHaiThanhCham"
-- ============================
local function TimPartGoc()
    -- Tìm trong ReplicatedStorage trước
    local partGoc = ReplicatedStorage:FindFirstChild("DinhHaiThanhCham", true)
    if partGoc and partGoc:IsA("BasePart") then
        return partGoc
    end

    -- Nếu không có, tìm trong toàn bộ Workspace
    partGoc = Workspace:FindFirstChild("DinhHaiThanhCham", true)
    if partGoc and partGoc:IsA("BasePart") then
        return partGoc
    end

    -- Tìm trong các thư mục con của game
    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant.Name == "DinhHaiThanhCham" and descendant:IsA("BasePart") then
            return descendant
        end
    end

    warn("[LOI] Khong tim thay Part 'DinhHaiThanhCham' trong game.")
    return nil
end

local partGoc = TimPartGoc()
if not partGoc then
    error("Part 'DinhHaiThanhCham' khong ton tai. Dung script.")
end
print("[OK] Da tim thay Part goc:", partGoc:GetFullName())

-- ============================
-- PHẦN 3: HÀM NHÂN BẢN PART
-- ============================
local function NhanBanPart(part)
    local clone = part:Clone()
    -- Đặt vị trí ngẫu nhiên quanh người chơi trong bán kính 10 studs
    local offsetX = math.random(-10, 10)
    local offsetY = math.random(0, 5)
    local offsetZ = math.random(-10, 10)
    clone.Position = rootPart.Position + Vector3.new(offsetX, offsetY, offsetZ)
    clone.Anchored = false
    clone.CanCollide = true
    clone.Parent = Workspace
    return clone
end

-- ============================
-- PHẦN 4: HÀM TỰ ĐỘNG THU THẬP PART (BỎ QUA HỆ THỐNG CỨU HỘ)
-- ============================
local function TuDongThuThap(part)
    -- Dịch chuyển người chơi đến vị trí part (bỏ qua khoảng cách)
    rootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)

    -- Kích hoạt sự kiện chạm để nhặt part nếu game dùng Touched event
    local touchInterest = part:FindFirstChild("TouchInterest")
    if touchInterest then
        firetouchinterest(part, rootPart, 0) -- firetouchinterest(part, characterPart, 0: touch, 1: untouch)
        firetouchinterest(part, rootPart, 1)
    end

    -- Nếu part có ProximityPrompt, tự động kích hoạt
    local proximityPrompt = part:FindFirstChildOfClass("ProximityPrompt")
    if proximityPrompt then
        proximityPrompt:InputHoldBegin()
        task.wait(0.1)
        proximityPrompt:InputHoldEnd()
    end

    -- Nếu part là Tool, tự động nhặt vào Backpack
    if part:IsA("Tool") then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            part.Parent = backpack
            print("[NHAT] Da nhat Tool:", part.Name)
        end
    end
end

-- ============================
-- PHẦN 5: LUỒNG SPAWN LIÊN TỤC VÀ THU THẬP
-- ============================
local dangChay = true
local soLanSpawn = 0

task.spawn(function()
    while dangChay do
        -- Nhân bản part gốc
        local clone = NhanBanPart(partGoc)
        soLanSpawn = soLanSpawn + 1
        print("[SPAWN] Da tao ban sao thu:", soLanSpawn)

        -- Chờ một chút để part ổn định trong Workspace
        task.wait(0.05)

        -- Tự động thu thập part vừa spawn
        TuDongThuThap(clone)

        -- Điều chỉnh tốc độ spawn (càng nhỏ càng nhanh, tối thiểu 0.01 để tránh crash)
        task.wait(0.1)
    end
end)

-- ============================
-- PHẦN 6: KẾT HỢP AUTO HEAL (BỎ QUA CỨU HỘ)
-- ============================
local AutoHeal = true
local HEAL_THRESHOLD = 80

task.spawn(function()
    while task.wait(0.3) do
        if not AutoHeal then continue end

        local char = player.Character
        if not char then continue end

        local hum = char:FindFirstChild("Humanoid")
        if not hum then continue end

        if hum.Health < HEAL_THRESHOLD then
            local currentTool = char:FindFirstChildOfClass("Tool")
            local bandage = char:FindFirstChild("băng gạc") or player.Backpack:FindFirstChild("băng gạc")

            if bandage then
                if bandage.Parent ~= char then
                    hum:EquipTool(bandage)
                end
                bandage:Activate()
                task.wait(0.3)
                if currentTool and currentTool.Parent ~= char then
                    hum:EquipTool(currentTool)
                end
            end
        end
    end
end)

-- ============================
-- PHẦN 7: LỆNH DỪNG SCRIPT (GÕ "stop" TRONG CONSOLE)
-- ============================
print("[LENH] Go 'stop' trong console de dung spawn part.")
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F9 then -- Nhấn F9 để dừng
        dangChay = false
        print("[DUNG] Da dung spawn part. Tong so da spawn:", soLanSpawn)
    end
end)

