-- Cấu hình Tool
local TEN_TOOL = "Hắc Long Katana"
local DAMAGE_MULTIPLIER = 999999
local AUTO_EQUIP = true
local AUTO_ATTACK = true
local BAN_KINH_ATTACK = 20
local DELAY_DANH = 0.4
local HIEN_THI_THONG_BAO = true

-- Biến
local hackTool = nil
local remoteCuaTool = nil
local SO_LAN_KILL = 0

-- Tìm Tool
local function TimTool()
    local tool = backpack and backpack:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then return tool end
    tool = character and character:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then return tool end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then return obj end
    end
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then return obj end
    end
    return nil
end

-- Phân tích Tool tìm Remote
local function PhanTichTool(tool)
    if not tool then return nil end
    local remotes = {}
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remotes, obj)
        end
    end
    if #remotes > 0 then return remotes[1] end
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local ten = obj.Name:lower()
            if ten:find("haclong") or ten:find("katana") or ten:find("damage") or ten:find("hit") or ten:find("sword") then
                table.insert(remotes, obj)
            end
        end
    end
    return #remotes > 0 and remotes[1] or nil
end

-- Gửi damage qua Remote
local function GuiDamage(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end
    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    local damage = math.min(humanoidDich.Health + 100, DAMAGE_MULTIPLIER)
    local formats = {
        {mucTieu, damage},
        {humanoidDich, damage},
        {mucTieu, damage, character},
        {character, mucTieu, damage},
    }

    local remotesToTry = {}
    if remoteCuaTool then table.insert(remotesToTry, remoteCuaTool) end
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then table.insert(remotesToTry, obj) end
        if #remotesToTry >= 10 then break end
    end

    for _, remote in ipairs(remotesToTry) do
        for i, args in ipairs(formats) do
            local ok = pcall(function() remote:FireServer(unpack(args)) end)
            if ok then
                task.wait(0.08)
                if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                    if not remoteCuaTool then remoteCuaTool = remote end
                    return true
                end
            end
        end
    end
    return false
end

-- Auto Attack
local function AutoAttack()
    if not hackTool or hackTool.Parent ~= character then return end

    local bestTarget = nil
    local bestDist = BAN_KINH_ATTACK

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local hd = obj:FindFirstChild("Humanoid")
            local rd = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hd and hd.Health > 0 and rd then
                if game:GetService("Players"):GetPlayerFromCharacter(obj) then continue end
                local dist = (rootPart.Position - rd.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestTarget = obj
                end
            end
        end
    end

    if bestTarget then
        local rd = bestTarget:FindFirstChild("HumanoidRootPart") or bestTarget:FindFirstChild("Head")
        if rd then
            local targetPos = rd.Position
            local myPos = rootPart.Position
            local dir = (targetPos - myPos).Unit
            local moveDist = math.min((targetPos - myPos).Magnitude - 2, 25)
            if moveDist > 0 then
                rootPart.CFrame = CFrame.new(myPos + dir * moveDist)
            end
            task.wait(0.08)
            pcall(function() hackTool:Activate() end)
            local killed = GuiDamage(bestTarget)
            if killed then
                SO_LAN_KILL = SO_LAN_KILL + 1
                if HIEN_THI_THONG_BAO then print("[KILL]", bestTarget.Name, "| Tong:", SO_LAN_KILL) end
            end
            task.wait(DELAY_DANH + math.random() * 0.3)
        end
    end
end

-- Auto Equip
local function AutoEquip()
    if not hackTool then return end
    if hackTool.Parent == backpack then
        humanoid:EquipTool(hackTool)
    elseif hackTool.Parent == Workspace then
        local oldCF = rootPart.CFrame
        rootPart.CFrame = hackTool:GetPivot()
        task.wait(0.3)
        local ti = hackTool:FindFirstChild("TouchInterest")
        if ti then
            firetouchinterest(hackTool, rootPart, 0)
            task.wait(0.1)
            firetouchinterest(hackTool, rootPart, 1)
        end
        task.wait(0.3)
        rootPart.CFrame = oldCF
        if hackTool.Parent == backpack then
            humanoid:EquipTool(hackTool)
        end
    end
end

-- Khởi tạo Tool
local function KhoiTao()
    hackTool = TimTool()
    if hackTool then
        remoteCuaTool = PhanTichTool(hackTool)
        if AUTO_EQUIP then AutoEquip() end
        print("[TOOL] Da tim thay:", TEN_TOOL)
    else
        print("[TOOL] Chua tim thay:", TEN_TOOL, "- se tu tim lai...")
    end
end
KhoiTao()

