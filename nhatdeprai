local function TaoVongTronKillAura()
    if not HIEN_THI_VONG_TRON then
        if vongTronKill then vongTronKill:Destroy(); vongTronKill = nil end
        return
    end

    if vongTronKill and vongTronKill.Parent then vongTronKill:Destroy() end

    vongTronKill = Instance.new("Part")
    vongTronKill.Name = "KillAuraRing"
    vongTronKill.Shape = Enum.PartType.Cylinder
    vongTronKill.Size = Vector3.new(BAN_KINH_KILL * 2, 0.3, BAN_KINH_KILL * 2)
    vongTronKill.Anchored = true
    vongTronKill.CanCollide = false
    vongTronKill.Transparency = 0.75
    vongTronKill.Color = Color3.fromRGB(255, 0, 0)
    vongTronKill.Material = Enum.Material.Neon
    vongTronKill.Parent = character
end

