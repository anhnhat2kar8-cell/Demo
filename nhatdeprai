-- CẤU HÌNH
-- ============================
local DAMAGE_MULTIPLIER = 999999 -- Hệ số nhân sát thương
local HITBOX_MO_RONG = 15 -- Bán kính hitbox mở rộng (studs)
local AUTO_ATTACK = true -- Tự động đánh kẻ địch gần nhất
local KHOANG_CACH_PAT_HIEN = 50 -- Khoảng cách phát hiện kẻ địch (studs)
local AN_TOAN_NGUOI_CHOI = true -- Không đánh người chơi khác (tránh bị report)

-- ============================
-- PHƯƠNG PHÁP 1: CAN THIỆP VÀO WEAPON/TOOL ĐỂ TĂNG SÁT THƯƠNG
-- ============================
local function TangSatThuongVuKhi()
    print("[PHUONG PHAP 1] Dang tang sat thuong vu khi...")

    -- Hook vào hàm tạo sát thương của Roblox
    local oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        -- Bắt sự kiện gây sát thương (TakeDamage, :Damage, Hit, v.v.)
        if method == "FireServer" and self.Name == "Damage" or self.Name == "Hit" or self.Name == "DealDamage" then
            -- Tăng damage lên
            if args[1] and type(args[1]) == "number" then
                args[1] = args[1] * DAMAGE_MULTIPLIER
                print("[DAMAGE] Da tang sat thuong len:", args[1])
                return oldNamecall(self, unpack(args))
            end
        end

        -- Bắt sự kiện TakeDamage trên Humanoid
        if method == "TakeDamage" and tostring(self) == "Humanoid" then
            local nhanVat = self.Parent
            -- Kiểm tra nếu không phải người chơi thì cho damage lớn
            if nhanVat and not Players:GetPlayerFromCharacter(nhanVat) then
                local damageMoi = args[1] and args[1] * DAMAGE_MULTIPLIER or 999999
                args[1] = damageMoi
                print("[DAMAGE] Gay", damageMoi, "sat thuong len:", nhanVat.Name)
                return oldNamecall(self, unpack(args))
            end
        end

        return oldNamecall(self, ...)
    end)

    print("[PHUONG PHAP 1] Da kich hoat!")
end

-- ============================
-- PHƯƠNG PHÁP 2: SET TRỰC TIẾP HEALTH KẺ ĐỊCH VỀ 0 (HIỆU QUẢ NHẤT)
-- ============================
local function SetHealthDichVe0(mucTieu)
    if not mucTieu then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if humanoidDich and humanoidDich.Health > 0 then
        -- Cách 1: Set thẳng Health về 0
        pcall(function()
            humanoidDich.Health = 0
        end)

        -- Cách 2: Dùng sự kiện TakeDamage với damage cực lớn
        pcall(function()
            humanoidDich:TakeDamage(999999)
        end)

        -- Cách 3: Phá hủy Humanoid
        pcall(function()
            humanoidDich:Destroy()
        end)

        print("[KILL] Da tieu diet:", mucTieu.Name)
        return true
    end
    return false
end

-- ============================
-- PHƯƠNG PHÁP 3: HITBOX MỞ RỘNG - ĐÁNH TRÚNG TẤT CẢ TRONG PHẠM VI
-- ============================
local function TimTatCaMucTieuTrongPhamVi()
    local danhSachMucTieu = {}

    -- Tìm tất cả NPC/Enemy trong Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local humanoidDich = obj:FindFirstChild("Humanoid")
            local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

            if humanoidDich and humanoidDich.Health > 0 and rootDich then
                -- Kiểm tra xem có phải người chơi không
                local laNguoiChoi = Players:GetPlayerFromCharacter(obj) ~= nil

                -- Nếu bật an toàn và là người chơi thì bỏ qua
                if AN_TOAN_NGUOI_CHOI and laNguoiChoi then
                    continue
                end

                -- Tính khoảng cách
                local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
                if khoangCach <= KHOANG_CACH_PAT_HIEN then
                    table.insert(danhSachMucTieu, obj)
                end
            end
        end
    end

    return danhSachMucTieu
end

-- ============================
-- PHƯƠNG PHÁP 4: AUTO ATTACK + ONE SHOT
-- ============================
task.spawn(function()
    while true do
        if AUTO_ATTACK then
            local cacMucTieu = TimTatCaMucTieuTrongPhamVi()

            if #cacMucTieu > 0 then
                -- Sắp xếp theo khoảng cách gần nhất
                table.sort(cacMucTieu, function(a, b)
                    local rootA = a:FindFirstChild("HumanoidRootPart") or a:FindFirstChild("Head")
                    local rootB = b:FindFirstChild("HumanoidRootPart") or b:FindFirstChild("Head")
                    if rootA and rootB then
                        return (rootPart.Position - rootA.Position).Magnitude < (rootPart.Position - rootB.Position).Magnitude
                    end
                    return false
                end)

                -- Tiêu diệt từng mục tiêu một
                for _, mucTieu in ipairs(cacMucTieu) do
                    if mucTieu and mucTieu.Parent then
                        local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
                        if rootDich then
                            -- Dịch chuyển đến mục tiêu (tùy chọn, có thể tắt)
                            -- rootPart.CFrame = rootDich.CFrame * CFrame.new(0, 2, 0)

                            -- Set Health về 0
                            SetHealthDichVe0(mucTieu)

                            -- Đợi một chút trước khi đánh mục tiêu tiếp theo
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
        task.wait(0.5) -- Thời gian giữa các lần quét
    end
end)

-- ============================
-- PHƯƠNG PHÁP 5: KILL AURA - KẺ ĐỊCH ĐẾN GẦN LÀ CHẾT
-- ============================
task.spawn(function()
    local KILL_AURA_BAN_KINH = 20 -- Bán kính kill aura

    while true do
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= character then
                local humanoidDich = obj:FindFirstChild("Humanoid")
                local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

                if humanoidDich and humanoidDich.Health > 0 and rootDich then
                    local laNguoiChoi = Players:GetPlayerFromCharacter(obj) ~= nil
                    if AN_TOAN_NGUOI_CHOI and laNguoiChoi then continue end

                    local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
                    if khoangCach <= KILL_AURA_BAN_KINH then
                        SetHealthDichVe0(obj)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

