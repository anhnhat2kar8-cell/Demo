-- ============================
-- BƯỚC 2: DÒ TÌM REMOTE EVENT SPAWN ITEM
-- ============================
local function DoTimRemoteSpawn()
    print("===========================================")
    print("[DO REMOTE] Dang phan tich RemoteEvent trong game...")

    cacRemoteKhaNghi = {}
    remoteSpawn = nil

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local ten = obj.Name:lower()
            local tenCha = obj.Parent and obj.Parent.Name:lower() or ""

            -- Từ khóa liên quan đến spawn/drop/give item
            local tuKhoa = {
                "spawn", "drop", "give", "create", "add", "item",
                "gacha", "roll", "summon", "generate", "loot",
                "chest", "reward", "gift", "spawnitem", "giveitem"
            }

            for _, tk in ipairs(tuKhoa) do
                if ten:find(tk) or tenCha:find(tk) then
                    table.insert(cacRemoteKhaNghi, obj)
                    print("  [KHA NGHI]", obj:GetFullName())

                    -- Ưu tiên Remote có tên trực tiếp
                    if ten == "spawn" or ten == "spawnitem" or ten == "drop" or ten == "give" then
                        remoteSpawn = obj
                        print("  [★★★ UU TIEN]", obj:GetFullName())
                    end
                    break
                end
            end
        end
    end

    print("[KET QUA] Tim thay " .. #cacRemoteKhaNghi .. " Remote kha nghi.")
    return #cacRemoteKhaNghi > 0
end

-- ============================
-- BƯỚC 3: THỬ GỬI YÊU CẦU SPAWN LÊN SERVER
-- ============================
local function ThuSpawnPartQuaRemote()
    if not partGoc then
        warn("[LOI] Khong co Part goc de spawn.")
        return false
    end

    print("[THU SPAWN] Dang thu spawn Part '" .. TEN_PART .. "' qua Remote...")

    -- Format tham số thử nghiệm
    local cacFormat = {
        -- Format 1: Chỉ tên Part
        {TEN_PART},
        -- Format 2: Tên Part + số lượng
        {TEN_PART, 1},
        -- Format 3: Tên Part + vị trí
        {TEN_PART, rootPart.Position},
        -- Format 4: Part gốc
        {partGoc},
        -- Format 5: Tên Part + vị trí + người chơi
        {TEN_PART, rootPart.Position, player},
        -- Format 6: "Spawn" + tên
        {"Spawn", TEN_PART},
        -- Format 7: "Give" + tên
        {"Give", TEN_PART},
        -- Format 8: "Drop" + tên + vị trí
        {"Drop", TEN_PART, rootPart.Position},
        -- Format 9: Tên + Vector3
        {TEN_PART, Vector3.new(math.random(-10,10), math.random(0,5), math.random(-10,10))},
        -- Format 10: Chỉ gửi vị trí (game tự spawn)
        {rootPart.Position + Vector3.new(math.random(-10,10), 0, math.random(-10,10))},
    }

    -- Danh sách Remote để thử (ưu tiên remoteSpawn)
    local remotesToTry = {}
    if remoteSpawn then table.insert(remotesToTry, remoteSpawn) end
    for _, r in ipairs(cacRemoteKhaNghi) do
        if r ~= remoteSpawn then table.insert(remotesToTry, r) end
    end
    -- Thêm tất cả RemoteEvent còn lại nếu cần
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") and not table.find(remotesToTry, obj) then
            table.insert(remotesToTry, obj)
        end
        if #remotesToTry >= 30 then break end
    end

    -- Đếm số Part hiện có trong Workspace trước khi spawn
    local function DemPartTrongWorkspace()
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == TEN_PART and obj:IsA("BasePart") then
                count = count + 1
            end
        end
        return count
    end

    local soPartTruoc = DemPartTrongWorkspace()

    -- Thử từng Remote với từng format
    for _, remote in ipairs(remotesToTry) do
        for i, thamSo in ipairs(cacFormat) do
            local thanhCong, loi = pcall(function()
                remote:FireServer(unpack(thamSo))
            end)

            if thanhCong then
                task.wait(0.3) -- Chờ Server xử lý

                -- Kiểm tra xem có Part mới được spawn không
                local soPartSau = DemPartTrongWorkspace()

                if soPartSau > soPartTruoc then
                    remoteSpawn = remote
                    thamSoSpawn = thamSo
                    print("[★★★ THANH CONG] Remote: " .. remote:GetFullName())
                    print("[★★★ THAM SO] Format " .. i .. ": " .. table.concat(thamSo, ", "))
                    print("[★★★ KET QUA] Part trong Workspace: " .. soPartTruoc .. " -> " .. soPartSau)
                    return true
                end
            end
        end
    end

    warn("[THAT BAI] Khong tim thay Remote spawn Part.")
    warn("[HUONG DAN] Hay spawn Part thu cong 1 lan trong game,")
    warn("           sau do chay lai script de no bat duoc Remote.")
    return false
end

-- ============================
-- BƯỚC 4: SPAWN PART QUA REMOTE (ĐÃ TÌM THẤY)
-- ============================
local function SpawnPartQuaRemoteDaBiet()
    if not remoteSpawn then return false end
    if not thamSoSpawn then return false end

    -- Tạo tham số mới với vị trí ngẫu nhiên
    local thamSoMoi = {}
    for i, ts in ipairs(thamSoSpawn) do
        if typeof(ts) == "Vector3" then
            local offsetX = math.random(-15, 15)
            local offsetY = math.random(0, 5)
            local offsetZ = math.random(-15, 15)
            table.insert(thamSoMoi, rootPart.Position + Vector3.new(offsetX, offsetY, offsetZ))
        elseif typeof(ts) == "Instance" and ts:IsA("BasePart") then
            -- Thay Part gốc
            table.insert(thamSoMoi, partGoc or ts)
        elseif ts == player then
            table.insert(thamSoMoi, player)
        else
            table.insert(thamSoMoi, ts)
        end
    end

    local thanhCong, loi = pcall(function()
        remoteSpawn:FireServer(unpack(thamSoMoi))
    end)

    return thanhCong
end

