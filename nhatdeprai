-- BƯỚC 1: DÒ TÌM REMOTE EVENT GÂY DAMAGE
-- ============================
local function DoTimRemoteDamage()
    tatCaRemote = {}
    remoteDamage = nil

    print("[DÒ REMOTE] Đang quét tất cả RemoteEvent trong game...")

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(tatCaRemote, obj)

            local ten = obj.Name:lower()
            local tenCha = obj.Parent and obj.Parent.Name:lower() or ""

            -- Ưu tiên Remote có tên liên quan đến damage
            if ten:find("damage") or ten:find("hit") or ten:find("deal") or
               ten:find("hurt") or ten:find("attack") or ten:find("swing") or
               ten:find("slash") or ten:find("punch") or ten:find("shoot") or
               ten:find("melee") or ten:find("weapon") or ten:find("combat") then
                remoteDamage = obj
                print("  [★★★ REMOTE DAMAGE] " .. obj:GetFullName())
            end
        end
    end

    print("[DÒ REMOTE] Tìm thấy " .. #tatCaRemote .. " RemoteEvent, ưu tiên: " .. (remoteDamage and remoteDamage.Name or "KHÔNG CÓ"))
end

-- ============================
-- BƯỚC 2: GỬI DAMAGE QUA REMOTE (ĐẢM BẢO KILL)
-- ============================
local function GuiDamageQuaRemote(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
    if not rootDich then return false end

    -- Danh sách format tham số thử nghiệm (theo thứ tự ưu tiên)
    local cacFormat = {
        -- Format 1: (mục tiêu, damage)
        {mucTieu, DAMAGE},
        {humanoidDich, DAMAGE},
        -- Format 2: (mục tiêu, damage, người đánh)
        {mucTieu, DAMAGE, character},
        {mucTieu, DAMAGE, rootPart},
        -- Format 3: (người đánh, mục tiêu, damage)
        {character, mucTieu, DAMAGE},
        {rootPart, mucTieu, DAMAGE},
        -- Format 4: Chỉ gửi mục tiêu (game tự tính damage)
        {mucTieu},
        {humanoidDich},
        -- Format 5: (damage, mục tiêu)
        {DAMAGE, mucTieu},
        -- Format 6: (mục tiêu, vị trí đánh, damage)
        {mucTieu, rootDich.Position, DAMAGE},
    }

    -- Danh sách Remote để thử (ưu tiên remoteDamage trước)
    local remotesToTry = {}
    if remoteDamage then table.insert(remotesToTry, remoteDamage) end
    for _, r in ipairs(tatCaRemote) do
        if r ~= remoteDamage then table.insert(remotesToTry, r) end
        if #remotesToTry >= 20 then break end -- Giới hạn 20 Remote để tránh lag
    end

    -- Thử từng Remote với từng format
    for _, remote in ipairs(remotesToTry) do
        for i, thamSo in ipairs(cacFormat) do
            local thanhCong, loi = pcall(function()
                remote:FireServer(unpack(thamSo))
            end)

            if thanhCong then
                task.wait(0.05)
                -- Kiểm tra xem mục tiêu đã chết chưa
                if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                    if not remoteDamage then
                        remoteDamage = remote
                        print("[★★★ TÌM THẤY REMOTE] " .. remote:GetFullName() .. " | Format: " .. i)
                    end
                    return true
                end
            end
        end
    end

    -- Nếu không kill được bằng Remote, thử trực tiếp
    pcall(function() humanoidDich.Health = 0 end)
    pcall(function() humanoidDich:TakeDamage(999999999) end)

    if not humanoidDich.Parent or humanoidDich.Health <= 0 then
        return true
    end

    return false
end

-- ============================
-- BƯỚC 3: TÌM TẤT CẢ MỤC TIÊU TRONG PHẠM VI HITBOX
-- ============================
local function TimTatCaMucTieu()
    local danhSach = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not obj:IsA("Model") then continue end
        if obj == character then continue end

        local humanoidDich = obj:FindFirstChild("Humanoid")
        if not humanoidDich or humanoidDich.Health <= 0 then continue end

        local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChild("Torso")
        if not rootDich then continue end

        -- Bỏ qua người chơi nếu cần
        if BO_QUA_NGUOI_CHOI and Players:GetPlayerFromCharacter(obj) then continue end

        -- Tính khoảng cách
        local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
        if khoangCach <= HITBOX_BAN_KINH then
            table.insert(danhSach, obj)
        end
    end

    -- Sắp xếp theo khoảng cách gần nhất
    table.sort(danhSach, function(a, b)
        local rdA = a:FindFirstChild("HumanoidRootPart") or a:FindFirstChild("Head")
        local rdB = b:FindFirstChild("HumanoidRootPart") or b:FindFirstChild("Head")
        if rdA and rdB then
            return (rootPart.Position - rdA.Position).Magnitude < (rootPart.Position - rdB.Position).Magnitude
        end
        return false
    end)

    return danhSach
end

-- ============================
-- BƯỚC 4: AUTO ATTACK VỚI HITBOX SIÊU XA
-- ============================
local function AutoAttackHitbox()
    if not AUTO_ATTACK then return end
    if not character or not character.Parent then return end

    -- Cố gắng cầm Tool nếu có
    local toolHienTai = character:FindFirstChildOfClass("Tool")
    if not toolHienTai and backpack then
        local toolBatKy = backpack:FindFirstChildOfClass("Tool")
        if toolBatKy then
            humanoid:EquipTool(toolBatKy)
            task.wait(0.2)
        end
    end

    local cacMucTieu = TimTatCaMucTieu()

    for _, mucTieu in ipairs(cacMucTieu) do
        if not mucTieu or not mucTieu.Parent then continue end
        if not AUTO_ATTACK then break end

        local humanoidDich = mucTieu:FindFirstChild("Humanoid")
        if not humanoidDich or humanoidDich.Health <= 0 then continue end

        -- Kích hoạt Tool nếu có
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end

        -- Gửi damage
        local daKill = GuiDamageQuaRemote(mucTieu)

        if daKill then
            SO_LAN_KILL = SO_LAN_KILL + 1
            print("[HITBOX KILL] " .. mucTieu.Name .. " | Khoảng cách: " .. math.floor((rootPart.Position - (mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")).Position).Magnitude) .. " studs | Tổng: " .. SO_LAN_KILL)
        end

        -- Delay giữa các lần đánh
        task.wait(DELAY_DANH)
    end
end

