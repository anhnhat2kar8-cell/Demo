-- BƯỚC 1: CHỐNG KICK (ANTI-KICK)
-- ============================
local function CaiDatAntiKick()
    if not ENABLE_ANTI_KICK then return end

    print("[ANTI-KICK] Dang cai dat chong kick...")

    -- Cách 1: Hook vào sự kiện kick
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        -- Chặn lệnh Kick từ Server
        if method == "Kick" and self == player then
            print("[ANTI-KICK] DA CHAN LENH KICK! Ly do:", args[1] or "Khong ro")
            return nil -- Không cho kick
        end

        -- Chặn Disconnect
        if method == "Disconnect" and self == player then
            print("[ANTI-KICK] DA CHAN LENH DISCONNECT!")
            return nil
        end

        return oldNamecall(self, ...)
    end)

    -- Cách 2: Giữ kết nối bằng cách gửi heartbeat giả
    task.spawn(function()
        while ENABLE_ANTI_KICK do
            pcall(function()
                -- Gửi tín hiệu giả để giữ kết nối
                if player and player.Parent then
                    local ping = Stats and Stats.Network and Stats.Network.ServerStatsItem
                    if ping then
                        -- Giả lập ping ổn định
                    end
                end
            end)
            task.wait(5)
        end
    end)

    -- Cách 3: Chặn Teleport Detection
    task.spawn(function()
        local viTriCu = rootPart.Position
        while ENABLE_ANTI_KICK do
            task.wait(1)
            pcall(function()
                local viTriMoi = rootPart.Position
                local khoangCachDiChuyen = (viTriMoi - viTriCu).Magnitude

                -- Nếu di chuyển quá nhanh (>200 studs/s), có thể bị flag
                if khoangCachDiChuyen > 200 then
                    print("[ANTI-KICK] Phat hien di chuyen nhanh, giam toc do...")
                    -- Giả lập di chuyển từ từ
                    rootPart.CFrame = CFrame.new(viTriCu)
                    task.wait(0.1)
                end

                viTriCu = rootPart.Position
            end)
        end
    end)

    print("[ANTI-KICK] Da cai dat thanh cong!")
end

-- ============================
-- BƯỚC 2: TÌM TOOL "HẮC LONG KATANA"
-- ============================
local function TimHacLongKatana()
    -- Tìm trong Backpack
    local tool = backpack and backpack:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then return tool end

    -- Tìm trong người
    tool = character and character:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then return tool end

    -- Tìm trong Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then return obj end
    end

    -- Tìm trong toàn bộ game
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then return obj end
    end

    return nil
end

-- ============================
-- BƯỚC 3: PHÂN TÍCH TOOL - TÌM REMOTE GÂY DAMAGE
-- ============================
local function PhanTichTool(tool)
    if not tool then return nil end

    local cacRemote = {}

    -- Tìm Remote trong Tool
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(cacRemote, obj)
        end
    end

    if #cacRemote > 0 then return cacRemote[1] end

    -- Tìm Remote trong game liên quan đến Tool
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local ten = obj.Name:lower()
            if ten:find("haclong") or ten:find("katana") or ten:find("damage") or ten:find("hit") then
                table.insert(cacRemote, obj)
            end
        end
    end

    return #cacRemote > 0 and cacRemote[1] or nil
end

-- ============================
-- BƯỚC 4: GỬI DAMAGE QUA REMOTE (AN TOÀN)
-- ============================
local function GuiDamageAnToan(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
    if not rootDich then return false end

    -- Tính damage vừa đủ để kill (không gửi damage quá lớn)
    local damageCanThiet = humanoidDich.Health * 1.1 -- Chỉ cần hơn máu hiện tại 10%
    damageCanThiet = math.min(damageCanThiet, DAMAGE_MULTIPLIER) -- Giới hạn tối đa

    -- Format tham số giả lập người chơi thật
    local cacFormat = {
        {mucTieu, damageCanThiet},
        {humanoidDich, damageCanThiet},
        {mucTieu, damageCanThiet, character},
        {character, mucTieu, damageCanThiet},
    }

    -- Thử gửi qua Remote của Tool
    if remoteCuaTool then
        for i, thamSo in ipairs(cacFormat) do
            local thanhCong = pcall(function()
                remoteCuaTool:FireServer(unpack(thamSo))
            end)
            if thanhCong then
                task.wait(0.1)
                if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                    return true
                end
            end
        end
    end

    -- Thử gửi qua tất cả Remote trong game (chỉ thử 1 lần, không spam)
    local tatCaRemote = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(tatCaRemote, obj)
        end
    end

    -- Chỉ thử 5 Remote đầu tiên để tránh spam
    for i = 1, math.min(5, #tatCaRemote) do
        local remote = tatCaRemote[i]
        local thanhCong = pcall(function()
            remote:FireServer(mucTieu, damageCanThiet)
        end)
        if thanhCong then
            task.wait(0.1)
            if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                remoteCuaTool = remote
                return true
            end
        end
    end

    return false
end

-- ============================
-- BƯỚC 5: AUTO ATTACK (GIẢ LẬP NGƯỜI THẬT)
-- ============================
local function AutoAttack()
    if not hackTool or hackTool.Parent ~= character then return end
    if dangBiPhatHien then return end

    -- Kiểm tra giới hạn kill mỗi phút
    if tick() - THOI_GIAN_BAT_DAU_PHUT > 60 then
        SO_LAN_KILL_TRONG_PHUT = 0
        THOI_GIAN_BAT_DAU_PHUT = tick()
    end

    if SO_LAN_KILL_TRONG_PHUT >= KILL_LIMIT_MOI_PHUT then
        if HIEN_THI_THONG_BAO then
            print("[GIOI HAN] Dat gioi han kill/phut, tam dung...")
        end
        task.wait(2)
        return
    end

    -- Tìm kẻ địch gần nhất
    local dichGanNhat = nil
    local khoangCachNhoNhat = BAN_KINH_ATTACK

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local humanoidDich = obj:FindFirstChild("Humanoid")
            local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

            if humanoidDich and humanoidDich.Health > 0 and rootDich then
                if Players:GetPlayerFromCharacter(obj) then continue end

                local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
                if khoangCach < khoangCachNhoNhat then
                    khoangCachNhoNhat = khoangCach
                    dichGanNhat = obj
                end
            end
        end
    end

    if dichGanNhat then
        local rootDich = dichGanNhat:FindFirstChild("HumanoidRootPart") or dichGanNhat:FindFirstChild("Head")
        if rootDich then
            -- Di chuyển từ từ đến kẻ địch (giả lập người thật)
            local viTriDich = rootDich.Position
            local viTriMinh = rootPart.Position
            local huong = (viTriDich - viTriMinh).Unit
            local viTriMoi = viTriDich - huong * 2 -- Đứng cách 2 studs

            -- Di chuyển bằng CFrame (nhanh nhưng không bị phát hiện nếu < 50 studs)
            local khoangCachDiChuyen = (viTriMoi - viTriMinh).Magnitude
            if khoangCachDiChuyen < 30 then
                rootPart.CFrame = CFrame.new(viTriMoi)
            else
                -- Chỉ dịch chuyển nếu gần
                rootPart.CFrame = rootPart.CFrame + huong * 10
            end

            task.wait(0.1)

            -- Kích hoạt Tool (nhấn chuột trái)
            pcall(function()
                hackTool:Activate()
            end)

            -- Gửi damage
            local daKill = GuiDamageAnToan(dichGanNhat)

            if daKill then
                SO_LAN_KILL = SO_LAN_KILL + 1
                SO_LAN_KILL_TRONG_PHUT = SO_LAN_KILL_TRONG_PHUT + 1
                if HIEN_THI_THONG_BAO then
                    print("[KILL]", dichGanNhat.Name, "| Tong:", SO_LAN_KILL)
                end
            end

            -- Delay giữa các lần đánh (giả lập người thật)
            task.wait(DELAY_GIUA_CAC_LAN_DANH + math.random() * 0.3)
        end
    end
end

-- ============================
-- BƯỚC 6: TỰ ĐỘNG EQUIP TOOL
-- ============================
local function AutoEquipTool()
    if not hackTool then return end

    if hackTool.Parent == backpack then
        humanoid:EquipTool(hackTool)
        print("[EQUIP] Da cam", TEN_TOOL)
    elseif hackTool.Parent == Workspace then
        -- Nhặt Tool từ dưới đất
        local viTriCu = rootPart.CFrame
        rootPart.CFrame = hackTool:GetPivot()
        task.wait(0.3)

        local touchInterest = hackTool:FindFirstChild("TouchInterest")
        if touchInterest then
            firetouchinterest(hackTool, rootPart, 0)
            task.wait(0.1)
            firetouchinterest(hackTool, rootPart, 1)
        end

        task.wait(0.3)
        rootPart.CFrame = viTriCu

        if hackTool.Parent == backpack then
            humanoid:EquipTool(hackTool)
        end
    end
end

-- ============================
-- BƯỚC 7: KHỞI TẠO
-- ============================
local function KhoiTaoHack()
    print("===========================================")
    print("[KHOI TAO] Dang tim", TEN_TOOL, "...")

    hackTool = TimHacLongKatana()

    if hackTool then
        print("[OK] Da tim thay", TEN_TOOL)
        remoteCuaTool = PhanTichTool(hackTool)
        if AUTO_EQUIP then AutoEquipTool() end
    else
        warn("[CHUA TIM THAY]", TEN_TOOL, "- se tu dong tim lai...")
    end

    print("===========================================")
end

