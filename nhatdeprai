-- ============================
-- AUTO HEAL
-- ============================
task.spawn(function()
    while task.wait(0.3) do
        if not autoHealBat then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum then continue end
        if hum.Health >= HEAL_THRESHOLD then continue end

        local currentTool = char:FindFirstChildOfClass("Tool")
        local bandage = char:FindFirstChild("băng gạc") or player.Backpack:FindFirstChild("băng gạc")
        if bandage then
            if bandage.Parent ~= char then hum:EquipTool(bandage) end
            bandage:Activate()
            task.wait(0.3)
            if currentTool and currentTool.Parent ~= char then hum:EquipTool(currentTool) end
        end
    end
end)

