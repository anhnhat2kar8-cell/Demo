-- Hàm tạo nút
local function TaoNut(ten, viTriY, textBatDau, batDauBat, mauBat, mauTat, callback)
    local nut = Instance.new("TextButton")
    nut.Name = ten .. "Button"
    nut.Size = UDim2.new(1, -20, 0, 35)
    nut.Position = UDim2.new(0, 10, 0, viTriY)
    nut.Text = textBatDau
    nut.TextColor3 = Color3.fromRGB(255, 255, 255)
    nut.TextScaled = true
    nut.Font = Enum.Font.SourceSansBold
    nut.BackgroundColor3 = batDauBat and mauBat or mauTat
    nut.BorderSizePixel = 0
    nut.AutoButtonColor = false
    nut.Parent = MainFrame

    local trangThai = batDauBat
    nut.Activated:Connect(function()
        trangThai = not trangThai
        nut.Text = string.gsub(textBatDau, "%[O[NF]*%]", trangThai and "[ON]" or "[OFF]")
        nut.BackgroundColor3 = trangThai and mauBat or mauTat
        if callback then callback(trangThai) end
    end)

    return nut
end

