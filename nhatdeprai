-- BƯỚC 5: SPAWN MỘT ĐỢT (15 PART)
-- ============================
local function SpawnMotDot()
    if not spawnDangChay then return end

    dotHienTai = dotHienTai + 1
    print("===========================================")
    print("[DOT " .. dotHienTai .. "] Bat dau spawn " .. SO_LAN_SPAWN_MOI_DOT .. " Part...")

    local soThanhCong = 0
    for i = 1, SO_LAN_SPAWN_MOI_DOT do
        local ok = false
        if remoteSpawn and thamSoSpawn then
            ok = SpawnPartQuaRemoteDaBiet()
        else
            ok = ThuSpawnPartQuaRemote()
        end

        if ok then
            soThanhCong = soThanhCong + 1
            tongSoSpawn = tongSoSpawn + 1
            print("  [" .. i .. "/" .. SO_LAN_SPAWN_MOI_DOT .. "] ✅ OK")
        else
            print("  [" .. i .. "/" .. SO_LAN_SPAWN_MOI_DOT .. "] ❌ LOI")
        end

        task.wait(0.1)
    end

    print("[DOT " .. dotHienTai .. "] Hoan thanh! Thanh cong: " .. soThanhCong .. "/" .. SO_LAN_SPAWN_MOI_DOT)
    print("[TONG] Da spawn: " .. tongSoSpawn .. " Part")
    print("===========================================")

    -- Auto Farm sau khi spawn
    if autoFarmBat then
        task.wait(0.5)
        TuDongThuThapTatCa()
    end
end

-- ============================
-- BƯỚC 6: AUTO FARM - THU THẬP PART
-- ============================
local function TuDongThuThapTatCa()
    if not autoFarmBat then return end

    local soNhat = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == TEN_PART and obj:IsA("BasePart") and obj.Parent == Workspace then
            -- Dịch chuyển đến Part
            rootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.05)

            -- TouchInterest
            local ti = obj:FindFirstChild("TouchInterest")
            if ti then
                firetouchinterest(obj, rootPart, 0)
                task.wait(0.05)
                firetouchinterest(obj, rootPart, 1)
            end

            -- ProximityPrompt
            local pp = obj:FindFirstChildOfClass("ProximityPrompt")
            if pp then
                pp:InputHoldBegin()
                task.wait(0.1)
                pp:InputHoldEnd()
            end

            -- Tool
            if obj:IsA("Tool") then
                local bp = player:FindFirstChild("Backpack")
                if bp then
                    obj.Parent = bp
                    soNhat = soNhat + 1
                end
            end
        end
    end

    if soNhat > 0 then
        print("[AUTO FARM] Da nhat " .. soNhat .. " Part/Tool")
    end
end

