local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ============================
-- PHƯƠNG PHÁP 1: DÙNG REMOTEEVENT CÓ SẴN TRONG GAME (PHỔ BIẾN NHẤT)
-- ============================
-- Nhiều game có RemoteEvent dùng để spawn item, bạn cần tìm đúng RemoteEvent đó.
-- Ví dụ: game.ReplicatedStorage.SpawnItem, game.ReplicatedStorage.Remotes.SpawnPart, v.v.

local function SpawnPartQuaRemoteEvent(partGoc)
    -- Tìm tất cả RemoteEvent trong game
    local tatCaRemote = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(tatCaRemote, obj)
        end
    end

    -- Thử từng RemoteEvent để spawn part
    for _, remote in ipairs(tatCaRemote) do
        local thanhCong = pcall(function()
            -- Thử gửi với nhiều format tham số khác nhau
            remote:FireServer(partGoc)                    -- Truyền trực tiếp part
            remote:FireServer(partGoc.Name)               -- Truyền tên part
            remote:FireServer("Spawn", partGoc.Name)      -- Format: lệnh + tên
            remote:FireServer(partGoc.Name, rootPart.Position) -- Tên + vị trí
        end)
        if thanhCong then
            print("[TIM THAY] RemoteEvent hoat dong:", remote:GetFullName())
            return true
        end
    end

    warn("[LOI] Khong tim thay RemoteEvent phu hop.")
    return false
end

-- ============================
-- PHƯƠNG PHÁP 2: DÙNG FIRETOUCHINTEREST ĐỂ GIẢ LẬP CHẠM PAD SPAWN
-- ============================
-- Một số game có pad spawn (part đặc biệt), khi chạm vào sẽ spawn ra item.
-- Ta có thể giả lập sự kiện chạm (TouchInterest) lên pad đó từ xa.

local function TimPadSpawn()
    -- Tìm part có chứa script spawn hoặc có tên liên quan đến spawn
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local tenThuong = obj.Name:lower()
            if tenThuong:find("spawn") or tenThuong:find("pad") or tenThuong:find("button") then
                -- Kiểm tra xem part này có TouchInterest không
                if obj:FindFirstChild("TouchInterest") then
                    return obj
                end
            end
        end
    end
    return nil
end

local function SpawnPartQuaTouchInterest(partGoc)
    local padSpawn = TimPadSpawn()
    if not padSpawn then
        warn("[LOI] Khong tim thay pad spawn.")
        return false
    end

    print("[PAD] Tim thay pad spawn:", padSpawn:GetFullName())

    -- Dịch chuyển character đến pad spawn
    local viTriCu = rootPart.CFrame
    rootPart.CFrame = padSpawn.CFrame * CFrame.new(0, 3, 0)
    task.wait(0.2)

    -- Kích hoạt TouchInterest
    local touchInterest = padSpawn:FindFirstChild("TouchInterest")
    if touchInterest then
        firetouchinterest(padSpawn, rootPart, 0) -- Touch
        task.wait(0.1)
        firetouchinterest(padSpawn, rootPart, 1) -- Untouch
    end

    -- Quay lại vị trí cũ
    task.wait(0.2)
    rootPart.CFrame = viTriCu
    return true
end

-- ============================
-- PHƯƠNG PHÁP 3: GỬI YÊU CẦU QUA PROXIMITYPROMPT
-- ============================
local function TimProximityPromptSpawn()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local tenThuong = obj.Parent and obj.Parent.Name:lower() or ""
            if tenThuong:find("spawn") or tenThuong:find("item") or tenThuong:find("gacha") then
                return obj
            end
        end
    end
    return nil
end

local function SpawnPartQuaProximityPrompt()
    local prompt = TimProximityPromptSpawn()
    if not prompt then
        warn("[LOI] Khong tim thay ProximityPrompt spawn.")
        return false
    end

    print("[PROMPT] Tim thay ProximityPrompt:", prompt:GetFullName())

    -- Dịch chuyển đến gần prompt
    local viTriCu = rootPart.CFrame
    local partCha = prompt.Parent
    if partCha and partCha:IsA("BasePart") then
        rootPart.CFrame = partCha.CFrame * CFrame.new(0, 2, 0)
    end
    task.wait(0.3)

    -- Kích hoạt prompt
    prompt:InputHoldBegin()
    task.wait(0.2)
    prompt:InputHoldEnd()

    -- Quay lại vị trí cũ
    task.wait(0.3)
    rootPart.CFrame = viTriCu
    return true
end

-- ============================
-- PHƯƠNG PHÁP 4: CAN THIỆP VÀO LUỒNG SỰ KIỆN CỦA GAME (ADVANCED)
-- ============================
-- Một số executor mạnh (Synapse X, Script-Ware) cho phép hook vào Metatable của Roblox
-- để bắt và sửa đổi sự kiện trước khi gửi lên Server.

local function SpawnPartQuaHook(partGoc)
    -- Phương pháp này yêu cầu executor hỗ trợ hookfunction hoặc newcclosure
    -- Kiểm tra xem executor có hỗ trợ không
    if not hookfunction or not newcclosure then
        warn("[LOI] Executor khong ho tro hookfunction.")
        return false
    end

    -- Hook vào FireServer của tất cả RemoteEvent
    local oldFireServer = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        local args = {...}
        -- Nếu phát hiện có part "DinhHaiThanhCham" trong tham số, cho phép gửi
        for _, arg in ipairs(args) do
            if typeof(arg) == "Instance" and arg.Name == "DinhHaiThanhCham" then
                print("[HOOK] Cho phep gui part len Server:", arg.Name)
                return oldFireServer(self, ...)
            end
        end
        -- Các trường hợp khác giữ nguyên
        return oldFireServer(self, ...)
    end)

    -- Thử gửi part qua bất kỳ RemoteEvent nào
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            pcall(function()
                remote:FireServer(partGoc)
            end)
        end
    end

    return true
end

-- ============================
-- PHƯƠNG PHÁP 5: DÙNG SCRIPT ĐỂ GỌI TRỰC TIẾP HÀM SERVER (RẤT HIẾM)
-- ============================
-- Một số game để lộ ModuleScript chứa hàm spawn, ta có thể require và gọi trực tiếp

local function SpawnPartQuaModuleScript(partGoc)
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local tenThuong = obj.Name:lower()
            if tenThuong:find("spawn") or tenThuong:find("item") or tenThuong:find("factory") then
                local thanhCong, module = pcall(require, obj)
                if thanhCong and type(module) == "table" then
                    -- Tìm hàm spawn trong module
                    for tenHam, ham in pairs(module) do
                        if type(ham) == "function" then
                            local ketQua, loi = pcall(ham, partGoc.Name, rootPart.Position)
                            if ketQua then
                                print("[MODULE] Goi ham spawn thanh cong:", obj:GetFullName(), "->", tenHam)
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

-- ============================
-- HÀM CHÍNH: THỬ TẤT CẢ CÁC PHƯƠNG PHÁP
-- ============================
local function SpawnPartServerSide(partGoc)
    if not partGoc then
        warn("[LOI] Part goc khong ton tai.")
        return false
    end

    print("===========================================")
    print("[DANG THU] Phuong phap 1: RemoteEvent...")
    if SpawnPartQuaRemoteEvent(partGoc) then
        print("[THANH CONG] Phuong phap 1: RemoteEvent")
        return true
    end

    print("[DANG THU] Phuong phap 2: TouchInterest...")
    if SpawnPartQuaTouchInterest(partGoc) then
        print("[THANH CONG] Phuong phap 2: TouchInterest")
        return true
    end

    print("[DANG THU] Phuong phap 3: ProximityPrompt...")
    if SpawnPartQuaProximityPrompt() then
        print("[THANH CONG] Phuong phap 3: ProximityPrompt")
        return true
    end

    print("[DANG THU] Phuong phap 4: ModuleScript...")
    if SpawnPartQuaModuleScript(partGoc) then
        print("[THANH CONG] Phuong phap 4: ModuleScript")
        return true
    end

    print("[DANG THU] Phuong phap 5: Hook FireServer...")
    if SpawnPartQuaHook(partGoc) then
        print("[THANH CONG] Phuong phap 5: Hook FireServer")
        return true
    end

    warn("===========================================")
    warn("[THAT BAI] Khong the spawn part server-side.")
    warn("[GOI Y] Game nay co the khong cho phep spawn part tu Client.")
    warn("[GOI Y] Thu tim hieu co che spawn cua game nay.")
    warn("===========================================")
    return false
end

-- ============================
-- TÌM PART GỐC VÀ BẮT ĐẦU SPAWN
-- ============================
local function TimPartGoc()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == "DinhHaiThanhCham" and obj:IsA("BasePart") then
            return obj
        end
    end
