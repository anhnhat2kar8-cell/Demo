-- ============================
-- TÌM PART GỐC
-- ============================
local function TimPartGoc()
    local partGoc = ReplicatedStorage:FindFirstChild("DinhHaiThanhCham", true)
    if partGoc and partGoc:IsA("BasePart") then return partGoc end
    partGoc = Workspace:FindFirstChild("DinhHaiThanhCham", true)
    if partGoc and partGoc:IsA("BasePart") then return partGoc end
    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant.Name == "DinhHaiThanhCham" and descendant:IsA("BasePart") then
            return descendant
        end
    end
    warn("[LOI] Khong tim thay Part 'DinhHaiThanhCham'.")
    return nil
end

local partGoc = TimPartGoc()
if partGoc then
    print("[OK] Da tim thay Part goc:", partGoc:GetFullName())
else
    print("[CANH BAO] Part 'DinhHaiThanhCham' khong ton tai.")
end

-- ============================
-- HÀM NHÂN BẢN PART VÀO WORKSPACE (SERVER-SIDE, MỌI NGƯỜI ĐỀU THẤY)
-- ============================
local function NhanBanPartServer(part)
    if not part or not part:IsA("BasePart") then return nil end

    local clone = part:Clone()

    -- Đặt vị trí ngẫu nhiên quanh người chơi
    local offsetX = math.random(-10, 10)
    local offsetY = math.random(0, 5)
    local offsetZ = math.random(-10, 10)

    clone.CFrame = rootPart.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
    clone.Anchored = false -- Không neo, để part có thể rơi tự nhiên
    clone.CanCollide = true -- Bật va chạm để người khác có thể tương tác
    clone.Parent = Workspace -- <<< THAY ĐỔI CHÍNH: Đặt vào Workspace, Server quản lý

    -- Thêm Highlight để dễ nhận biết (mọi người đều thấy)
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 255, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineTransparency = 0
    highlight.Parent = clone

    return clone
end

-- ============================
-- HÀM TỰ ĐỘNG THU THẬP PART (AUTO FARM)
-- ============================
local function TuDongThuThap(part)
    if not part or not part.Parent then return end

    -- Dịch chuyển người chơi đến vị trí part
    rootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)

    -- Kích hoạt TouchInterest nếu có
    local touchInterest = part:FindFirstChild("TouchInterest")
    if touchInterest then
        firetouchinterest(part, rootPart, 0) -- Touch
        task.wait(0.05)
        firetouchinterest(part, rootPart, 1) -- Untouch
    end

    -- Kích hoạt ProximityPrompt nếu có
    local proximityPrompt = part:FindFirstChildOfClass("ProximityPrompt")
    if proximityPrompt then
        proximityPrompt:InputHoldBegin()
        task.wait(0.1)
        proximityPrompt:InputHoldEnd()
    end

    -- Nếu part là Tool, tự động nhặt vào Backpack
    if part:IsA("Tool") and part.Parent == Workspace then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            part.Parent = backpack
            print("[NHAT] Da nhat Tool:", part.Name)
        end
    end
end

-- ============================
-- HÀM DỌN DẸP PART CŨ (TRÁNH LAG SERVER)
-- ============================
local function DonDepPart()
    -- Giới hạn tối đa 100 part trong Workspace cùng lúc
    while #danhSachPart > 100 do
        local partCu = table.remove(danhSachPart, 1)
        if partCu and partCu.Parent then
            partCu:Destroy()
        end
    end
end

-- ============================
-- LUỒNG SPAWN PART SERVER-SIDE (MỌI NGƯỜI ĐỀU THẤY)
-- ============================
task.spawn(function()
    while true do
        task.wait(0.15) -- Tốc độ spawn (có thể điều chỉnh)
        if spawnDangChay and partGoc then
            local clone = NhanBanPartServer(partGoc)
            if clone then
                soLanSpawn = soLanSpawn + 1
                table.insert(danhSachPart, clone)
                DonDepPart()
                print("[SPAWN SERVER] Da tao ban sao thu:", soLanSpawn, "| Part trong Workspace - MOI NGUOI DEU THAY")

                -- Tự động thu thập nếu Auto Farm đang bật
                if autoFarmBat then
                    task.wait(0.05)
                    TuDongThuThap(clone)
                end
            end
        end
    end
end)

-- ============================
-- HÀM XÓA TOÀN BỘ PART
-- ============================
local function XoaTatCaPart()
    for _, part in ipairs(danhSachPart) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    danhSachPart = {}
    soLanSpawn = 0
    print("[DON DEP] Da xoa tat ca part trong Workspace.")
end

-- ============================
-- LUỒNG AUTO HEAL
-- ============================
task.spawn(function()
    while task.wait(0.3) do
        if not autoHealBat then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum then continue end
        if hum.Health >= HEAL_THRESHOLD then continue end

        local currentTool = char:FindFirstChildOfClass("Tool")
        local bandage = char:FindFirstChild("băng gạc") or player.Backpack:FindFirstChild("băng gạc")
        if bandage then
            if bandage.Parent ~= char then
                hum:EquipTool(bandage)
            end
            bandage:Activate()
            task.wait(0.3)
            if currentTool and currentTool.Parent ~= char then
                hum:EquipTool(currentTool)
            end
        end
    end
end)

