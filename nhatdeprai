    nut.TextColor3 = Color3.fromRGB(255, 255, 255)
    nut.TextScaled = true
    nut.Font = Enum.Font.SourceSansBold
    nut.BackgroundColor3 = bat and mauOn or mauOff
    nut.BorderSizePixel = 1
    nut.AutoButtonColor = false
    nut.Parent = MainFrame

    local state = bat
    nut.Activated:Connect(function()
        state = not state
        nut.Text = state and onText or offText
        nut.BackgroundColor3 = state and mauOn or mauOff
        if cb then cb(state) end
    end)
    return nut
end

