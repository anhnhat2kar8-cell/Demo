-- BƯỚC 1: TỰ ĐỘNG DÒ TÌM REMOTE EVENT GÂY SÁT THƯƠNG
-- ============================
local function DoTimRemoteDamage()
    print("===========================================")
    print("[DO TIM] Dang phan tich RemoteEvent trong game...")

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local ten = obj.Name:lower()
            local tenCha = obj.Parent and obj.Parent.Name:lower() or ""

            -- Các từ khóa liên quan đến gây sát thương
            local tuKhoaDamage = {
                "damage", "hit", "attack", "deal", "hurt",
                "slash", "punch", "shoot", "stab", "kill",
                "combat", "fight", "weapon", "swing", "fire",
                "takendamage", "applydamage", "dealdamage",
                "melee", "ranged", "bullet", "projectile"
            }

            local khaNghi = false
            for _, tk in ipairs(tuKhoaDamage) do
                if ten:find(tk) or tenCha:find(tk) then
                    khaNghi = true
                    break
                end
            end

            if khaNghi then
                table.insert(cacRemoteKhaNghi, obj)
                print("  [KHA NGHI]", obj:GetFullName(), "| Loai:", obj.ClassName)

                -- Ưu tiên Remote có tên trực tiếp là "Damage" hoặc "Hit"
                if ten == "damage" or ten == "deal" or ten == "hit" then
                    remoteDamage = obj
                    print("  [★★★] Remote uu tien:", obj:GetFullName())
                end
            end
        end
    end

    print("[KET QUA] Tim thay", #cacRemoteKhaNghi, "Remote kha nghi.")
    return #cacRemoteKhaNghi > 0
end

