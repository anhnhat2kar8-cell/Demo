-- BƯỚC 2: THỬ GÂY SÁT THƯƠNG QUA TỪNG REMOTE
-- ============================
local function ThuGaySatThuong(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    -- Lấy thông tin mục tiêu
    local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
    local tenDich = mucTieu.Name

    -- Thử TẤT CẢ các Remote kha nghi với nhiều format tham số
    for _, remote in ipairs(cacRemoteKhaNghi) do
        -- Danh sách các format tham số có thể có
        local cacFormat = {
            -- Format 1: (mucTieu, damage)
            {mucTieu, 999999},
            {humanoidDich, 999999},
            {rootDich, 999999},

            -- Format 2: (mucTieu, damage, ...)
            {mucTieu, 999999, rootPart},
            {humanoidDich, 999999, rootPart},

            -- Format 3: (nguoiTranCong, mucTieu, damage)
            {character, mucTieu, 999999},
            {rootPart, mucTieu, 999999},

            -- Format 4: (damage, mucTieu)
            {999999, mucTieu},
            {999999, humanoidDich},

            -- Format 5: Chi gửi mục tiêu (game tự tính damage)
            {mucTieu},
            {humanoidDich},

            -- Format 6: (mucTieu, "Damage", 999999)
            {mucTieu, "Damage", 999999},

            -- Format 7: Vector3 hit position + damage
            {rootDich.Position, 999999, mucTieu},
        }

        for i, thamSo in ipairs(cacFormat) do
            local thanhCong, loi = pcall(function()
                remote:FireServer(unpack(thamSo))
            end)

            if thanhCong then
                -- Kiểm tra xem mục tiêu đã chết chưa
                task.wait(0.1)
                if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                    remoteDamage = remote
                    print("[★★★ THANH CONG] Remote:", remote:GetFullName(), "| Format:", i)
                    SO_LAN_KILL = SO_LAN_KILL + 1
                    return true
                end
            end
        end
    end

    -- Nếu không kill được bằng Remote, thử dùng Tool có sẵn
    return ThuKillBangTool(mucTieu)
end

-- ============================
-- BƯỚC 3: THỬ KILL BẰNG TOOL (VU KHÍ)
-- ============================
local function ThuKillBangTool(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
    if not rootDich then return false end

    -- Tìm tool/vũ khí trong Backpack hoặc đang cầm
    local tools = {}
    for _, obj in ipairs(player.Backpack:GetChildren()) do
        if obj:IsA("Tool") then table.insert(tools, obj) end
    end
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool then table.insert(tools, currentTool) end

    for _, tool in ipairs(tools) do
        -- Cầm tool lên
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
            task.wait(0.1)
        end

        -- Dịch chuyển đến mục tiêu
        local viTriCu = rootPart.CFrame
        rootPart.CFrame = rootDich.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.1)

        -- Kích hoạt tool (đánh)
        pcall(function()
            tool:Activate()
        end)

        -- Kích hoạt sự kiện chạm
        local touchInterest = rootDich:FindFirstChild("TouchInterest")
        if touchInterest then
            firetouchinterest(rootDich, rootPart, 0)
            task.wait(0.05)
            firetouchinterest(rootDich, rootPart, 1)
        end

        task.wait(0.2)

        -- Kiểm tra xem đã kill chưa
        if not humanoidDich.Parent or humanoidDich.Health <= 0 then
            print("[★★★ KILL BANG TOOL]", tool.Name, "->", mucTieu.Name)
            SO_LAN_KILL = SO_LAN_KILL + 1
            rootPart.CFrame = viTriCu
            return true
        end

        rootPart.CFrame = viTriCu
    end

    return false
end

