-- CẤU HÌNH KILL AURA
-- ============================
local killAuraBat = true -- Bật/Tắt Kill Aura
local BAN_KINH_KILL = 25 -- Bán kính kill (studs), ai trong phạm vi này sẽ chết
local BO_QUA_NGUOI_CHOI = true -- Bỏ qua người chơi khác (chỉ kill NPC/quái)
local BO_QUA_DONG_DOI = true -- Bỏ qua đồng đội (nếu game có team)
local HIEN_THI_HIEU_UNG = true -- Hiển thị vòng tròn kill aura
local HIEN_THI_THONG_BAO = true -- Hiển thị thông báo khi kill
local THOI_GIAN_QUET = 0.1 -- Thời gian giữa mỗi lần quét (càng nhỏ càng nhanh)
local SO_LAN_KILL = 0 -- Đếm số lần kill

-- ============================
-- HÀM KIỂM TRA ĐỒNG ĐỘI
-- ============================
local function LaDongDoi(mucTieu)
    if not BO_QUA_DONG_DOI then return false end

    -- Cách 1: Kiểm tra qua Team (nếu game dùng hệ thống Team của Roblox)
    if player.Team and mucTieu and Players:GetPlayerFromCharacter(mucTieu) then
        local nguoiChoiDich = Players:GetPlayerFromCharacter(mucTieu)
        if nguoiChoiDich and nguoiChoiDich.Team == player.Team then
            return true
        end
    end

    -- Cách 2: Kiểm tra qua Team tag trong Humanoid hoặc Model
    local teamTag = mucTieu:FindFirstChild("Team") or mucTieu:FindFirstChild("TeamTag")
    if teamTag and teamTag.Value == player.Team then
        return true
    end

    return false
end

-- ============================
-- HÀM KILL MỤC TIÊU
-- ============================
local function KillMucTieu(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    -- Cách 1: Set thẳng Health về 0 (hiệu quả nhất)
    local thanhCong, loi = pcall(function()
        humanoidDich.Health = 0
    end)

    if not thanhCong then
        -- Cách 2: Dùng sự kiện TakeDamage với sát thương cực lớn
        pcall(function()
            humanoidDich:TakeDamage(999999999)
        end)
    end

    -- Cách 3: Phá hủy Humanoid triệt để
    if humanoidDich.Health > 0 then
        pcall(function()
            humanoidDich:Destroy()
        end)
    end

    -- Hiệu ứng kill (tùy chọn)
    if HIEN_THIEU_UNG then
        pcall(function()
            local hieuUng = Instance.new("Explosion")
            hieuUng.Position = humanoidDich.Parent:GetPivot().Position
            hieuUng.BlastRadius = 1
            hieuUng.BlastPressure = 0
            hieuUng.Visible = true
            hieuUng.Parent = Workspace
            task.delay(1, function()
                if hieuUng then hieuUng:Destroy() end
            end)
        end)
    end

    SO_LAN_KILL = SO_LAN_KILL + 1
    return true
end

-- ============================
-- HÀM TÌM TẤT CẢ MỤC TIÊU TRONG PHẠM VI
-- ============================
local function TimTatCaMucTieu()
    local danhSach = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- Chỉ xét Model (có Humanoid)
        if not obj:IsA("Model") then continue end
        if obj == character then continue end -- Bỏ qua chính mình

        local humanoidDich = obj:FindFirstChild("Humanoid")
        local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChild("Torso")

        -- Kiểm tra điều kiện
        if not humanoidDich then continue end
        if humanoidDich.Health <= 0 then continue end
        if not rootDich then continue end

        -- Bỏ qua người chơi nếu được bật
        local laNguoiChoi = Players:GetPlayerFromCharacter(obj) ~= nil
        if BO_QUA_NGUOI_CHOI and laNguoiChoi then continue end

        -- Bỏ qua đồng đội
        if LaDongDoi(obj) then continue end

        -- Tính khoảng cách
        local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
        if khoangCach <= BAN_KINH_KILL then
            table.insert(danhSach, {
                Model = obj,
                Humanoid = humanoidDich,
                RootPart = rootDich,
                KhoangCach = khoangCach,
                LaNguoiChoi = laNguoiChoi,
                Ten = obj.Name
            })
        end
    end

    -- Sắp xếp theo khoảng cách gần nhất
    table.sort(danhSach, function(a, b)
        return a.KhoangCach < b.KhoangCach
    end)

    return danhSach
end

-- ============================
-- LUỒNG KILL AURA CHÍNH
-- ============================
task.spawn(function()
    while true do
        if killAuraBat and character and character.Parent then
            local cacMucTieu = TimTatCaMucTieu()

            for _, mt in ipairs(cacMucTieu) do
                if killAuraBat and mt.Model and mt.Model.Parent then
                    local daKill = KillMucTieu(mt.Model)

                    if daKill and HIEN_THI_THONG_BAO then
                        local loai = mt.LaNguoiChoi and "👤 PLAYER" or "👾 NPC"
                        print("[KILL AURA] Da kill:", mt.Ten, "|", loai, "| Khoang cach:", math.floor(mt.KhoangCach), "studs")
                    end
                end
            end

            -- In tổng kết nếu có kill
            if #cacMucTieu > 0 then
                -- Không in liên tục tránh spam console
            end
        end
        task.wait(THOI_GIAN_QUET)
    end
end)

