-- BƯỚC 7: LUỒNG SPAWN CHÍNH
-- ============================
task.spawn(function()
    while true do
        if spawnDangChay and remoteTimThay then
            dotHienTai = dotHienTai + 1
            print("===========================================")
            print("[DOT " .. dotHienTai .. "] Spawn " .. SO_LAN_SPAWN_MOI_DOT .. " Part len Server...")

            for i = 1, SO_LAN_SPAWN_MOI_DOT do
                local thanhCong = SpawnPartQuaServer(i)
                if thanhCong then
                    print("  [" .. i .. "/" .. SO_LAN_SPAWN_MOI_DOT .. "] OK")
                else
                    print("  [" .. i .. "/" .. SO_LAN_SPAWN_MOI_DOT .. "] LOI")
                end
                task.wait(0.1)
            end

            print("[DOT " .. dotHienTai .. "] Hoan thanh!")
            print("===========================================")

            -- Auto Farm sau khi spawn xong
            if autoFarmBat then
                task.wait(0.5)
                print("[AUTO FARM] Dang thu nhat part...")
                TuDongThuThap()
            end
        end
        task.wait(THOI_GIAN_GIUA_CAC_DOT)
    end
end)

-- ============================
-- BƯỚC 8: AUTO HEAL (GIỮ NGUYÊN)
-- ============================
task.spawn(function()
    while task.wait(0.3) do
        if not autoHealBat then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum then continue end
        if hum.Health >= HEAL_THRESHOLD then continue end

        local currentTool = char:FindFirstChildOfClass("Tool")
        local bandage = char:FindFirstChild("băng gạc") or player.Backpack:FindFirstChild("băng gạc")
        if bandage then
            if bandage.Parent ~= char then
                hum:EquipTool(bandage)
            end
            bandage:Activate()
            task.wait(0.3)
            if currentTool and currentTool.Parent ~= char then
                hum:EquipTool(currentTool)
            end
        end
    end
end)

