-- ============================
-- DÒ TÌM REMOTE EVENT GÂY SÁT THƯƠNG
-- ============================
local function DoTimRemoteDamage()
    cacRemoteKhaNghi = {}
    remoteDamage = nil

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local ten = obj.Name:lower()
            local tenCha = obj.Parent and obj.Parent.Name:lower() or ""

            local tuKhoaDamage = {
                "damage", "hit", "attack", "deal", "hurt",
                "slash", "punch", "shoot", "stab", "kill",
                "combat", "fight", "weapon", "swing", "fire",
                "takendamage", "applydamage", "dealdamage",
                "melee", "ranged", "bullet", "projectile"
            }

            local khaNghi = false
            for _, tk in ipairs(tuKhoaDamage) do
                if ten:find(tk) or tenCha:find(tk) then
                    khaNghi = true
                    break
                end
            end

            if khaNghi then
                table.insert(cacRemoteKhaNghi, obj)
                if ten == "damage" or ten == "deal" or ten == "hit" then
                    remoteDamage = obj
                end
            end
        end
    end

    return #cacRemoteKhaNghi > 0
end

-- ============================
-- THỬ GÂY SÁT THƯƠNG QUA REMOTE
-- ============================
local function ThuGaySatThuong(mucTieu)
    if not mucTieu or not mucTieu.Parent then return false end

    local humanoidDich = mucTieu:FindFirstChild("Humanoid")
    if not humanoidDich or humanoidDich.Health <= 0 then return false end

    local rootDich = mucTieu:FindFirstChild("HumanoidRootPart") or mucTieu:FindFirstChild("Head")
    if not rootDich then return false end

    -- Bay đến mục tiêu nếu bật
    if KHOANG_CACH_BAY > 0 then
        local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
        if khoangCach > KHOANG_CACH_BAY then
            rootPart.CFrame = rootDich.CFrame * CFrame.new(0, 2, 0)
            task.wait(0.05)
        end
    end

    -- Format tham số thử nghiệm
    local cacFormat = {
        {mucTieu, 999999},
        {humanoidDich, 999999},
        {mucTieu, 999999, character},
        {mucTieu, 999999, rootPart},
        {character, mucTieu, 999999},
        {rootPart, mucTieu, 999999},
        {999999, mucTieu},
        {mucTieu},
        {humanoidDich},
        {mucTieu, "Damage", 999999},
        {rootDich.Position, 999999, mucTieu},
    }

    for _, remote in ipairs(cacRemoteKhaNghi) do
        for i, thamSo in ipairs(cacFormat) do
            local thanhCong, loi = pcall(function()
                remote:FireServer(unpack(thamSo))
            end)
            if thanhCong then
                task.wait(0.05)
                if not humanoidDich.Parent or humanoidDich.Health <= 0 then
                    remoteDamage = remote
                    SO_LAN_KILL = SO_LAN_KILL + 1
                    return true
                end
            end
        end
    end

    return false
end

-- ============================
-- TÌM VÀ KILL TẤT CẢ MỤC TIÊU
-- ============================
local function TimVaKillTatCaMucTieu()
    if not killAuraBat then return 0 end
    if not character or not character.Parent then return 0 end

    local danhSachMucTieu = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not obj:IsA("Model") then continue end
        if obj == character then continue end

        local humanoidDich = obj:FindFirstChild("Humanoid")
        if not humanoidDich or humanoidDich.Health <= 0 then continue end

        local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
        if not rootDich then continue end

        -- Bỏ qua người chơi
        local laNguoiChoi = Players:GetPlayerFromCharacter(obj) ~= nil
        if BO_QUA_NGUOI_CHOI and laNguoiChoi then continue end

        -- Bỏ qua đồng đội
        if BO_QUA_DONG_DOI and laNguoiChoi then
            local nguoiChoiDich = Players:GetPlayerFromCharacter(obj)
            if nguoiChoiDich and player.Team and nguoiChoiDich.Team == player.Team then
                continue
            end
        end

        local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
        if khoangCach <= BAN_KINH_KILL then
            table.insert(danhSachMucTieu, obj)
        end
    end

    for _, mucTieu in ipairs(danhSachMucTieu) do
        if mucTieu and mucTieu.Parent then
            ThuGaySatThuong(mucTieu)
        end
    end

    return #danhSachMucTieu
end

