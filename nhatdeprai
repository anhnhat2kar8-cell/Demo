end

local partGoc = TimPartGoc()
if partGoc then
    print("[OK] Tim thay part goc:", partGoc:GetFullName())
    SpawnPartServerSide(partGoc)
else
    warn("[LOI] Khong tim thay part 'DinhHaiThanhCham' trong game.")
    warn("[GOI Y] Hay dam bao part co ten CHINH XAC nhu tren.")
end

