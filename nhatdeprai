-- ============================
-- BƯỚC 1: TÌM TOOL "HẮC LONG KATANA"
-- ============================
local function TimHacLongKatana()
    -- Tìm trong Backpack trước
    local tool = backpack and backpack:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then
        print("[TIM THAY] Hắc Long Katana trong Backpack!")
        return tool
    end

    -- Tìm trong người (đang cầm)
    tool = character and character:FindFirstChild(TEN_TOOL)
    if tool and tool:IsA("Tool") then
        print("[TIM THAY] Hắc Long Katana dang cam tren tay!")
        return tool
    end

    -- Tìm trong Workspace (rơi trên đất)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then
            print("[TIM THAY] Hắc Long Katana trong Workspace!")
            return obj
        end
    end

    -- Tìm trong các thư mục khác
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == TEN_TOOL and obj:IsA("Tool") then
            print("[TIM THAY] Hắc Long Katana tai:", obj:GetFullName())
            return obj
        end
    end

    return nil
end

-- ============================
-- BƯỚC 2: PHÂN TÍCH TOOL - TÌM REMOTE EVENT GÂY DAMAGE
-- ============================
local function PhanTichTool(tool)
    if not tool then return nil end

    print("[PHAN TICH] Dang phan tich Hắc Long Katana...")

    -- Tìm tất cả RemoteEvent trong Tool
    local cacRemote = {}
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(cacRemote, obj)
            print("  [REMOTE TRONG TOOL]", obj:GetFullName())
        end
    end

    -- Nếu Tool có RemoteEvent riêng, ưu tiên dùng
    if #cacRemote > 0 then
        print("[OK] Tool co", #cacRemote, "RemoteEvent rieng.")
        return cacRemote[1] -- Lấy Remote đầu tiên
    end

    -- Tìm RemoteEvent trong game mà Tool có thể dùng
    -- Thường là các Remote có tên liên quan đến Tool
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local ten = obj.Name:lower()
            local tenTool = TEN_TOOL:lower():gsub(" ", "")

            -- Tìm Remote có tên liên quan đến Hắc Long Katana
            if ten:find("haclong") or ten:find("katana") or ten:find("sword") or
               ten:find("melee") or ten:find("weapon") or ten:find("damage") then
                print("  [REMOTE KHA NGHI]", obj:GetFullName())
                table.insert(cacRemote, obj)
            end
        end
    end

    if #cacRemote > 0 then
        return cacRemote[1]
    end

    -- Nếu không tìm thấy, dùng tất cả RemoteEvent trong game
    warn("[CANH BAO] Khong tim thay Remote cua Tool, se thu tat ca Remote.")
    return nil
end

-- ============================
-- BƯỚC 3: HOOK REMOTE ĐỂ TĂNG DAMAGE
-- ============================
local function HookRemoteTangDamage()
    print("[HOOK] Dang cai dat hook tang damage...")

    -- Hook metamethod __namecall để bắt FireServer
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        -- Bắt tất cả FireServer từ RemoteEvent
        if method == "FireServer" and self:IsA("RemoteEvent") then
            -- Kiểm tra xem có phải Remote của Tool không
            local laRemoteCuaTool = false

            if remoteCuaTool and self == remoteCuaTool then
                laRemoteCuaTool = true
            end

            -- Hoặc kiểm tra Tool đang được cầm
            if hackTool and hackTool.Parent == character then
                -- Nếu Remote nằm trong Tool hoặc có liên quan
                if self:IsDescendantOf(hackTool) then
                    laRemoteCuaTool = true
                end
            end

            -- Nếu là Remote của Tool, tăng damage
            if laRemoteCuaTool then
                -- Duyệt qua các tham số, tìm và thay đổi giá trị damage
                for i, arg in ipairs(args) do
                    if type(arg) == "number" and arg > 0 and arg < 10000 then
                        -- Đây có thể là damage, nhân lên
                        local damageCu = arg
                        args[i] = arg * DAMAGE_MULTIPLIER
                        if HIEN_THI_THONG_BAO then
                            print("[DAMAGE] Da tang:", damageCu, "->", args[i])
                        end
                        break
                    end
                end

                -- Nếu không tìm thấy damage trong args, thêm damage vào
                local coDamage = false
                for _, arg in ipairs(args) do
                    if type(arg) == "number" and arg > 1000 then
                        coDamage = true
                        break
                    end
                end

                if not coDamage then
                    -- Thêm damage vào cuối
                    table.insert(args, DAMAGE_MULTIPLIER)
                    print("[DAMAGE] Da them damage:", DAMAGE_MULTIPLIER)
                end

                return oldNamecall(self, unpack(args))
            end
        end

        -- Bắt TakeDamage trên Humanoid (phương pháp dự phòng)
        if method == "TakeDamage" and tostring(self) == "Humanoid" then
            local nhanVat = self.Parent
            -- Nếu không phải người chơi, tăng damage
            if nhanVat and not Players:GetPlayerFromCharacter(nhanVat) then
                if hackTool and hackTool.Parent == character then
                    args[1] = (args[1] or 10) * DAMAGE_MULTIPLIER
                    return oldNamecall(self, unpack(args))
                end
            end
        end

        return oldNamecall(self, ...)
    end)

    print("[HOOK] Da cai dat thanh cong!")
end

-- ============================
-- BƯỚC 4: KÍCH HOẠT TOOL LIÊN TỤC (AUTO ATTACK)
-- ============================
local function AutoAttack()
    if not hackTool or hackTool.Parent ~= character then return end

    -- Tìm kẻ địch gần nhất
    local dichGanNhat = nil
    local khoangCachNhoNhat = BAN_KINH_ATTACK

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local humanoidDich = obj:FindFirstChild("Humanoid")
            local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

            if humanoidDich and humanoidDich.Health > 0 and rootDich then
                -- Bỏ qua người chơi
                if Players:GetPlayerFromCharacter(obj) then continue end

                local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
                if khoangCach < khoangCachNhoNhat then
                    khoangCachNhoNhat = khoangCach
                    dichGanNhat = obj
                end
            end
        end
    end

    if dichGanNhat then
        local rootDich = dichGanNhat:FindFirstChild("HumanoidRootPart") or dichGanNhat:FindFirstChild("Head")
        if rootDich then
            -- Bay đến kẻ địch
            local viTriCu = rootPart.CFrame
            rootPart.CFrame = rootDich.CFrame * CFrame.new(0, 2, 0)
            task.wait(0.05)

            -- Kích hoạt Tool
            pcall(function()
                hackTool:Activate()
            end)

            task.wait(0.1)
            rootPart.CFrame = viTriCu

            -- Kiểm tra xem đã kill chưa
            local humanoidDich = dichGanNhat:FindFirstChild("Humanoid")
            if humanoidDich and humanoidDich.Health <= 0 then
                SO_LAN_KILL = SO_LAN_KILL + 1
                print("[KILL] Da tieu diet:", dichGanNhat.Name, "| Tong kill:", SO_LAN_KILL)
            end
        end
    end
end

-- ============================
-- BƯỚC 5: TỰ ĐỘNG EQUIP TOOL
-- ============================
local function AutoEquipTool()
    if not hackTool then return end

    -- Nếu Tool đang ở Backpack, cầm lên
    if hackTool.Parent == backpack then
        humanoid:EquipTool(hackTool)
        print("[EQUIP] Da cam Hắc Long Katana!")
    end

    -- Nếu Tool đang rơi trên đất, nhặt lên
    if hackTool.Parent == Workspace then
        -- Dịch chuyển đến Tool
        rootPart.CFrame = hackTool:GetPivot()
        task.wait(0.2)

        -- Nhặt Tool
        local touchInterest = hackTool:FindFirstChild("TouchInterest")
        if touchInterest then
            firetouchinterest(hackTool, rootPart, 0)
            task.wait(0.1)
            firetouchinterest(hackTool, rootPart, 1)
        end

        -- Nếu Tool có ProximityPrompt
        local prompt = hackTool:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            prompt:InputHoldBegin()
            task.wait(0.1)
            prompt:InputHoldEnd()
        end

        task.wait(0.3)

        -- Kiểm tra lại xem đã nhặt được chưa
        if hackTool.Parent == backpack then
            humanoid:EquipTool(hackTool)
            print("[EQUIP] Da nhat va cam Hắc Long Katana!")
        end
    end
end

