local function TaoNutBatTat(ten, viTriY, batDauBat, moTaBat, moTaTat, mauBat, mauTat, callback)
    local nut = Instance.new("TextButton")
    nut.Name = ten .. "Button"
    nut.Size = UDim2.new(1, -20, 0, 42)
    nut.Position = UDim2.new(0, 10, 0, viTriY)
    nut.Text = batDauBat and moTaBat or moTaTat
    nut.TextColor3 = Color3.fromRGB(255, 255, 255)
    nut.TextScaled = true
    nut.Font = Enum.Font.SourceSansBold
    nut.BackgroundColor3 = batDauBat and (mauBat or Color3.fromRGB(50, 180, 50)) or (mauTat or Color3.fromRGB(180, 50, 50))
    nut.BorderSizePixel = 1
    nut.BorderColor3 = Color3.fromRGB(80, 80, 80)
    nut.AutoButtonColor = false
    nut.Parent = MainFrame

    local trangThai = batDauBat
    nut.Activated:Connect(function()
        trangThai = not trangThai
        nut.Text = trangThai and moTaBat or moTaTat
        nut.BackgroundColor3 = trangThai and (mauBat or Color3.fromRGB(50, 180, 50)) or (mauTat or Color3.fromRGB(180, 50, 50))
        if callback then callback(trangThai) end
    end)

    return nut
end

