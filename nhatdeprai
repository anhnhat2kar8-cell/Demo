-- ============================
-- BƯỚC 1: TÌM PART GỐC
-- ============================
local function TimPartGoc()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj.Name == "DinhHaiThanhCham" and obj:IsA("BasePart") then
            return obj
        end
    end
    return nil
end

local partGoc = TimPartGoc()
