-- BƯỚC 5: VÒNG TRÒN HIỂN THỊ HITBOX
-- ============================
local function TaoVongTronHitbox()
    if not HIEN_VONG_TRON then
        if vongTron then vongTron:Destroy(); vongTron = nil end
        return
    end

    if vongTron and vongTron.Parent then vongTron:Destroy() end

    vongTron = Instance.new("Part")
    vongTron.Name = "HitboxRing"
    vongTron.Shape = Enum.PartType.Cylinder
    vongTron.Size = Vector3.new(HITBOX_BAN_KINH * 2, 0.3, HITBOX_BAN_KINH * 2)
    vongTron.Anchored = true
    vongTron.CanCollide = false
    vongTron.Transparency = 0.7
    vongTron.Color = Color3.fromRGB(255, 100, 0)
    vongTron.Material = Enum.Material.Neon
    vongTron.Parent = character

    print("[HITBOX] Đã tạo vòng tròn bán kính " .. HITBOX_BAN_KINH .. " studs")
end

