-- PHƯƠNG PHÁP 6: CLICK TP KILL - CLICK VÀO ĐỊCH ĐỂ GIẾT
-- ============================
local function ClickTPKill()
    local mouse = player:GetMouse()

    mouse.Button1Down:Connect(function()
        local mucTieu = mouse.Target
        if mucTieu then
            -- Tìm model cha chứa Humanoid
            local modelCha = mucTieu
            while modelCha and not modelCha:IsA("Model") do
                modelCha = modelCha.Parent
            end

            if modelCha and modelCha ~= character then
                local humanoidDich = modelCha:FindFirstChild("Humanoid")
                if humanoidDich and humanoidDich.Health > 0 then
                    -- Dịch chuyển đến mục tiêu
                    rootPart.CFrame = mucTieu.CFrame * CFrame.new(0, 2, 0)
                    task.wait(0.1)

                    -- Tiêu diệt
                    SetHealthDichVe0(modelCha)
                    print("[CLICK KILL] Da tieu diet:", modelCha.Name)
                end
            end
        end
    end)
end

-- Kích hoạt Click TP Kill
ClickTPKill()

