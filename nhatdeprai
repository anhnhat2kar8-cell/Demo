-- ============================
-- KILL NGƯỜI CHƠI GÂY SÁT THƯƠNG CHO MÌNH (PHẢN ĐÒN)
-- ============================
local function PhanDonKill()
    if not character then return end

    local humanoidHienTai = character:FindFirstChild("Humanoid")
    if not humanoidHienTai then return end

    -- Lắng nghe sự kiện mất máu
    local healthCu = humanoidHienTai.Health

    task.spawn(function()
        while killAuraBat and character and character.Parent do
            local humanoidNow = character:FindFirstChild("Humanoid")
            if not humanoidNow then break end

            -- Nếu bị mất máu đột ngột, tìm kẻ tấn công
            if humanoidNow.Health < healthCu then
                -- Tìm kẻ địch gần nhất (có thể là người vừa đánh mình)
                local cacMucTieu = TimTatCaMucTieu()
                for _, mt in ipairs(cacMucTieu) do
                    if mt.KhoangCach <= BAN_KINH_KILL then
                        KillMucTieu(mt.Model)
                        print("[PHAN DON] Da kill ke tan cong:", mt.Ten)
                    end
                end
            end

            healthCu = humanoidNow.Health
            task.wait(0.2)
        end
    end)
end

