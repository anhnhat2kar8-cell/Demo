    print("[PART GOC] Tim thay:", partGoc:GetFullName())
else
    warn("[PART GOC] KHONG tim thay Part 'DinhHaiThanhCham' trong game!")
end

-- ============================
-- BƯỚC 2: PHÂN TÍCH TẤT CẢ REMOTEEVENT ĐỂ TÌM REMOTE SPAWN ITEM
-- ============================
local function PhanTichRemoteEvent()
    print("===========================================")
    print("[DANG DO] Dang phan tich tat ca RemoteEvent...")

    local tatCaRemote = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(tatCaRemote, obj)
        end
    end

    print("[TIM THAY] Tong so RemoteEvent:", #tatCaRemote)

    -- Kiểm tra từng RemoteEvent
    for _, remote in ipairs(tatCaRemote) do
        local tenRemote = remote.Name:lower()
        local tenCha = remote.Parent and remote.Parent.Name:lower() or ""

        -- In ra tất cả RemoteEvent để người dùng biết
        print("  [KHAO SAT]", remote:GetFullName())

        -- Đoán xem remote này có liên quan đến spawn item không
        local coKhaNang = false
        if tenRemote:find("spawn") or tenRemote:find("item") or tenRemote:find("drop") or
           tenRemote:find("give") or tenRemote:find("create") or tenRemote:find("add") or
           tenCha:find("spawn") or tenCha:find("item") or tenCha:find("drop") then
            coKhaNang = true
            print("    [PHA HIEN] Remote co kha nang spawn item!")
            remoteTimThay = remote
            return remote
        end
    end

    warn("[THAT BAI] Khong tim thay RemoteEvent spawn tu dong.")
    warn("[HUONG DAN] Hay thu spawn item thu cong trong game, sau do xem RemoteSpy")
    return nil
end

-- ============================
-- BƯỚC 3: THỬ TẤT CẢ CÁC CÁCH GỬI YÊU CẦU SPAWN LÊN SERVER
-- ============================
local function ThuTatCaCachSpawn()
    print("===========================================")
    print("[DANG THU] Dang thu tat ca cac cach spawn Part len Server...")

    -- Cách 1: Dùng RemoteEvent đã tìm thấy
    if remoteTimThay then
        print("[CACH 1] Thu gui qua RemoteEvent:", remoteTimThay:GetFullName())

        -- Thử nhiều format tham số khác nhau
        local cacFormatThamSo = {
            {"DinhHaiThanhCham"},
            {"DinhHaiThanhCham", 1},
            {"DinhHaiThanhCham", rootPart.Position},
            {partGoc},
            {"Spawn", "DinhHaiThanhCham"},
            {"Give", "DinhHaiThanhCham"},
            {"Create", "DinhHaiThanhCham", rootPart.Position},
        }

        for i, thamSo in ipairs(cacFormatThamSo) do
            local thanhCong, loi = pcall(function()
                remoteTimThay:FireServer(unpack(thamSo))
            end)
            if thanhCong then
                print("  [THANH CONG] Format", i, "thanh cong!")
                cacThamSoServer = thamSo
                return true
            else
                print("  [THAT BAI] Format", i, "loi:", loi)
            end
            task.wait(0.2)
        end
    end

    -- Cách 2: Thử TẤT CẢ RemoteEvent với nhiều tham số
    print("[CACH 2] Thu TAT CA RemoteEvent voi nhieu tham so...")
    local tatCaRemote = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            table.insert(tatCaRemote, obj)
        end
    end

    for _, remote in ipairs(tatCaRemote) do
        local cacThamSo = {
            {"DinhHaiThanhCham"},
            {"DinhHaiThanhCham", rootPart.Position},
            {partGoc},
        }
        for _, thamSo in ipairs(cacThamSo) do
            local thanhCong, loi = pcall(function()
                remote:FireServer(unpack(thamSo))
            end)
            if thanhCong then
                print("  [THANH CONG] Remote:", remote:GetFullName(), "| Tham so:", table.concat(thamSo, ", "))
                remoteTimThay = remote
                cacThamSoServer = thamSo
                return true
            end
        end
    end

    warn("[THAT BAI] Khong the spawn Part len Server bang RemoteEvent.")
    return false
end

-- ============================
-- BƯỚC 4: HÀM SPAWN PART LÊN SERVER (DÙNG REMOTE ĐÃ TÌM THẤY)
-- ============================
local function SpawnPartQuaServer(viTri)
    if not remoteTimThay or not cacThamSoServer then
        warn("[LOI] Chua tim thay RemoteEvent hoac tham so.")
        return false
    end

    -- Sửa đổi tham số để thay đổi vị trí spawn (nếu có thể)
    local thamSoMoi = {}
    for i, ts in ipairs(cacThamSoServer) do
        if typeof(ts) == "Vector3" then
            -- Thay đổi vị trí spawn xung quanh người chơi
            local offsetX = math.random(-10, 10)
            local offsetZ = math.random(-10, 10)
            table.insert(thamSoMoi, rootPart.Position + Vector3.new(offsetX, 0, offsetZ))
        else
            table.insert(thamSoMoi, ts)
        end
    end

    local thanhCong, loi = pcall(function()
        remoteTimThay:FireServer(unpack(thamSoMoi))
    end)

    if thanhCong then
        return true
    else
        warn("[LOI] FireServer that bai:", loi)
        return false
    end
end

-- ============================
-- BƯỚC 5: HÀM TỰ ĐỘNG THU THẬP PART (AUTO FARM)
-- ============================
local function TuDongThuThap()
    -- Tìm part "DinhHaiThanhCham" trong Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "DinhHaiThanhCham" and obj:IsA("BasePart") and obj.Parent == Workspace then
            -- Dịch chuyển đến part
            rootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.05)

            -- Kích hoạt TouchInterest
            local touchInterest = obj:FindFirstChild("TouchInterest")
            if touchInterest then
                firetouchinterest(obj, rootPart, 0)
                task.wait(0.05)
                firetouchinterest(obj, rootPart, 1)
            end

            -- Kích hoạt ProximityPrompt
            local proximityPrompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if proximityPrompt then
                proximityPrompt:InputHoldBegin()
                task.wait(0.1)
                proximityPrompt:InputHoldEnd()
            end

            -- Nhặt Tool
            if obj:IsA("Tool") then
                local backpack = player:FindFirstChild("Backpack")
                if backpack then
                    obj.Parent = backpack
                    print("[NHAT] Da nhat Tool:", obj.Name)
                end
            end
        end
    end
end

