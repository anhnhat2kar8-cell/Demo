-- BƯỚC 4: TÌM VÀ KILL TẤT CẢ MỤC TIÊU TRONG PHẠM VI
-- ============================
local function TimVaKillTatCaMucTieu()
    if not killAuraBat then return end
    if not character or not character.Parent then return end

    local danhSachMucTieu = {}

    -- Tìm tất cả Model có Humanoid trong Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not obj:IsA("Model") then continue end
        if obj == character then continue end

        local humanoidDich = obj:FindFirstChild("Humanoid")
        if not humanoidDich or humanoidDich.Health <= 0 then continue end

        local rootDich = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
        if not rootDich then continue end

        -- Bỏ qua người chơi
        if BO_QUA_NGUOI_CHOI and Players:GetPlayerFromCharacter(obj) then continue end

        -- Tính khoảng cách
        local khoangCach = (rootPart.Position - rootDich.Position).Magnitude
        if khoangCach <= BAN_KINH_KILL then
            table.insert(danhSachMucTieu, obj)
        end
    end

    -- Kill từng mục tiêu
    for _, mucTieu in ipairs(danhSachMucTieu) do
        if mucTieu and mucTieu.Parent then
            local daKill = ThuGaySatThuong(mucTieu)

            if DANG_DEBUG then
                if daKill then
                    print("[KILL]", mucTieu.Name, "✅")
                else
                    print("[THAT BAI]", mucTieu.Name, "❌ - Khong tim thay cach kill")
                end
            end
        end
    end

    return #danhSachMucTieu
end

